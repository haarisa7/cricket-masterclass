# Copy this file to .env and fill in the values for local development.
# In production these live on the Cloudflare Worker, NOT in this repo.
#
#   RESEND_API_KEY is a SECRET:  npx wrangler secret put RESEND_API_KEY
#   The other two are plain vars and can go in the Worker's environment.
#
# Without RESEND_API_KEY the indoor interest form returns its WhatsApp fallback
# error rather than silently dropping enquiries.


# --- Resend API key -----------------------------------------------------------
# https://resend.com/api-keys — create one with "Sending access" only.
RESEND_API_KEY=


# --- Where enquiries are delivered -------------------------------------------
# IMPORTANT WHILE USING THE SHARED TEST SENDER (see below): Resend will ONLY
# deliver to the email address your Resend account is registered with. Any other
# recipient is refused with a 403. So until the domain is verified, this must be
# your own Resend account email — not info@masterclasscricket.co.uk.
#
# There is no fallback in code: leave this blank and the form errors with an
# explanation, rather than guessing an address and losing every enquiry.
ENQUIRY_TO_EMAIL=


# --- Who the email comes from ------------------------------------------------
# Defaults to Resend's shared test sender if left blank, which needs no domain
# verification and works immediately:
#
#   Masterclass Cricket <onboarding@resend.dev>
#
# BEFORE LAUNCH, verify masterclasscricket.co.uk in Resend (three DNS records)
# and switch to an address on that domain. Mail from a shared resend.dev address
# is much more likely to be filtered as spam, and the recipient restriction
# above disappears once the domain is verified:
#
#   ENQUIRY_FROM_EMAIL=Masterclass Cricket <enquiries@masterclasscricket.co.uk>
#   ENQUIRY_TO_EMAIL=info@masterclasscricket.co.uk
ENQUIRY_FROM_EMAIL=
